        title="@i18n/app/title"
        icon="@res/img/app_icon.png">

        <brls:Tab label="@i18n/app/tabs/modules">
            <ModuleListTab />
        </brls:Tab>

        <brls:Tab label="@i18n/app/tabs/profiles">
